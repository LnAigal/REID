# Database
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/reid?schema=public"

# JWT
JWT_SECRET="your-super-secret-jwt-key-change-in-production"
JWT_EXPIRATION="7d"

# CSRF (must be different from JWT_SECRET)
CSRF_SECRET="your-super-secret-csrf-key-change-in-production"

# Optional. When the API and dashboard are served from different subdomains
# (e.g. api.reid.dev and app.reid.dev), set this to the shared parent domain
# so the auth/CSRF cookies set by the API are also sent to the dashboard and
# its middleware can see them. Leave unset for host-only cookies (localhost,
# single-domain deployments).
COOKIE_DOMAIN=".reid.dev"

# API
API_PORT=3001
API_PREFIX="api/v1"

# Set to true ONLY when running behind a reverse proxy (nginx, Traefik, etc.).
# When exposed directly, trusting X-Forwarded-For lets clients spoof their IP
# and bypass rate limiting.
TRUST_PROXY=false

# CORS
CORS_ORIGIN="http://localhost:3000"

# Brevo SMTP
BREVO_API_KEY="your-brevo-api-key"

# Verification
VERIFICATION_FROM_EMAIL="noreply@reid.dev"

# App
APP_NAME="REID"
APP_URL="http://localhost:3000"

# Webhooks (optional) — sign provider delivery events with HMAC-SHA256.
# Sent via the "X-Webhook-Signature" header. If unset, webhooks are accepted
# unverified (development only).
WEBHOOK_SECRET="your-webhook-secret-change-in-production"
